;/*++
;
;Copyright (c) Microsoft Corporation All rights Reserved
;
;Module Name:
;
;    VhidminiUm.inf
;
;Abstract:
;    INF file for installing HID minidriver (UMDF 2 version)
;
; Installation Notes:
;    Using Devcon: Type "devcon install VhidminiUm.inf root\KnxVirtualHid" to install
;
; Important:
;    This INF depends on MsHidUmdf.inf, which was introduced in build 22000
;
;--*/
[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%ProviderString%
DriverVer=10/01/2002,6.0.5058.0
CatalogFile=wudf.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1=%Disk_Description%,,,

[SourceDisksFiles]
VhidminiUm.dll=1

; ================= Device section =====================

[Manufacturer]
%ManufacturerString%=KnxVirtual, NT$ARCH$.10.0...22000

[KnxVirtual.NT$ARCH$.10.0...22000]
%DeviceDesc%=VhidminiUm, root\KnxVirtualHid

[VhidminiUm.NT]
CopyFiles=UMDriverCopy
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT

[VhidminiUm.NT.hw]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.hw
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.hw

[VhidminiUm.NT.Services]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.Services
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Services

[VhidminiUm.NT.Filters]
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Filters

[VhidminiUm.NT.Wdf]
UmdfService="VhidminiUm", VhidminiUm_Install
UmdfServiceOrder=VhidminiUm
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction=Copy
UmdfFsContextUsePolicy=CanUseFsContext2

[VhidminiUm_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary="%13%\VhidminiUm.dll"

; ================= copy files =====================

[UMDriverCopy]
VhidminiUm.dll

;---------------------------------------------------------------;

[Strings]
ProviderString     ="QtKnxBleUsbif Project"
ManufacturerString ="QtKnxBleUsbif Project"
ClassName          ="KNX Virtual HID"
Disk_Description   ="KNX Virtual HID (UMDF 2) Installation Disk"
DeviceDesc         ="KNX Virtual USB Interface (UMDF 2)"
WudfRdDisplayName  ="Windows Driver Foundation - User-mode Driver Framework Reflector"
