;/*++
;
;Copyright (c) Microsoft Corporation All rights Reserved
;
;Module Name:
;
;    VhidminiUm.inf
;
;Abstract:
;    INF file for installing HID minidriver (UMDF 2 version)
;
; Installation Notes:
;    Using Devcon: Type "devcon install VhidminiUm.inf root\KnxVirtualHid" to install
;
; Windows 10 21H1+ uses the legacy inbox mshidumdf/WUDFRd services.
; Windows 11 22000+ uses the newer inbox MsHidUmdf/WUDFRD INFs.
;
;--*/
[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%ProviderString%
DriverVer=10/01/2002,6.0.5058.0
CatalogFile=wudf.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1=%Disk_Description%,,,

[SourceDisksFiles]
VhidminiUm.dll=1

; ================= Device section =====================

[Manufacturer]
%ManufacturerString%=KnxVirtual, NT$ARCH$.10.0...19043, NT$ARCH$.10.0...22000

[KnxVirtual.NT$ARCH$.10.0...19043]
%DeviceDesc%=VhidminiUmWin10, root\KnxVirtualHid

[KnxVirtual.NT$ARCH$.10.0...22000]
%DeviceDesc%=VhidminiUm, root\KnxVirtualHid

; Windows 10 does not provide MsHidUmdf.inf or WUDFRD.inf. Explicitly
; bind the inbox HID mapper as the function driver and WUDFRd as its
; lower filter. The same UMDF 2 DLL and HID protocol are used on both OSes.
[VhidminiUmWin10.NT]
CopyFiles=UMDriverCopy

[VhidminiUmWin10.NT.hw]
AddReg=VhidminiUmWin10_LowerFilter

[VhidminiUmWin10_LowerFilter]
HKR,,LowerFilters,0x00010008,"WUDFRd"

[VhidminiUmWin10.NT.Services]
AddService=WUDFRd,0x000001f8,WUDFRD_ServiceInstall
AddService=mshidumdf,0x000001fa,MSHIDUMDF_ServiceInstall

[WUDFRD_ServiceInstall]
DisplayName=%WudfRdDisplayName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\WUDFRd.sys

[MSHIDUMDF_ServiceInstall]
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\mshidumdf.sys

[VhidminiUmWin10.NT.Wdf]
UmdfService="VhidminiUm", VhidminiUm_Install
UmdfServiceOrder=VhidminiUm
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction=Copy
UmdfFsContextUsePolicy=CanUseFsContext2

[VhidminiUm.NT]
CopyFiles=UMDriverCopy
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT

[VhidminiUm.NT.hw]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.hw
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.hw

[VhidminiUm.NT.Services]
Include=MsHidUmdf.inf
Needs=MsHidUmdf.NT.Services
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Services

[VhidminiUm.NT.Filters]
Include=WUDFRD.inf
Needs=WUDFRD_LowerFilter.NT.Filters

[VhidminiUm.NT.Wdf]
UmdfService="VhidminiUm", VhidminiUm_Install
UmdfServiceOrder=VhidminiUm
UmdfKernelModeClientPolicy=AllowKernelModeClients
UmdfFileObjectPolicy=AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction=Copy
UmdfFsContextUsePolicy=CanUseFsContext2

[VhidminiUm_Install]
UmdfLibraryVersion=$UMDFVERSION$
ServiceBinary="%13%\VhidminiUm.dll"

; ================= copy files =====================

[UMDriverCopy]
VhidminiUm.dll

;---------------------------------------------------------------;

[Strings]
ProviderString     ="QtKnxBleUsbif Project"
ManufacturerString ="QtKnxBleUsbif Project"
ClassName          ="KNX Virtual HID"
Disk_Description   ="KNX Virtual HID (UMDF 2) Installation Disk"
DeviceDesc         ="KNX Virtual USB Interface (UMDF 2)"
WudfRdDisplayName  ="Windows Driver Foundation - User-mode Driver Framework Reflector"
